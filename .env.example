# Copy to .env and fill in real values:  cp .env.example .env

# The subdomain that points (DNS-only / gray cloud) at this VM's public IP
DOMAIN=dfs.pranayx.tech

# Postgres password (any strong value)
DB_PASSWORD=replace-with-a-strong-db-password

# JWT signing secret — MUST be at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# JVM heap for the app. Raise if your VM has plenty of RAM; lower if it is small.
JAVA_OPTS=-Xmx1024m
